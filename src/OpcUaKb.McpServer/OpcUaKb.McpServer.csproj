<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- dotnet tool packaging -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>opcua-kb-mcp</ToolCommandName>
    <PackageId>OpcUaKb.McpServer</PackageId>
    <Description>OPC UA Knowledge Base MCP Server — 17 tools for searching specs, RAG Q&amp;A, validating NodeSets, checking compliance, profile-graph conformance, and live-server companion-spec projection. Connects to an Azure AI Search index of all OPC UA specifications and companion specs.</Description>
    <Authors>Marc Schier</Authors>
    <PackageProjectUrl>https://github.com/marcschier/opcuakb-mcp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/marcschier/opcuakb-mcp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>opcua;mcp;model-context-protocol;knowledge-base</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageReference Include="Azure.Storage.Queues" Version="12.28.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpcUaKb.Core\OpcUaKb.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="/" />
    <None Include=".mcp\server.json" Pack="true" PackagePath="/.mcp/" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>OpcUaKbHostedAgent</RootNamespace>
    <AssemblyName>OpcUaKb.HostedAgent</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);OPENAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Last hosting release compatible with the manifest's Responses v1 protocol. -->
    <PackageReference Include="Microsoft.Agents.AI.Foundry.Hosting" Version="1.11.1-preview.260625.1" />
    <!-- Foundry SDK — provides AIProjectClient and AsAIAgent. -->
    <PackageReference Include="Azure.AI.Projects" Version="2.1.0-beta.4" />
    <!-- MCP client — connects directly to our OpcUaKb.McpServer over SSE so each of the
         17 tools (search_docs, list_specs, ...) is exposed as a distinct AIFunction
         that GPT-4o can call by name. -->
    <PackageReference Include="ModelContextProtocol" Version="2.3.0" />
    <!-- .env file support for local development. -->
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
  </ItemGroup>

</Project>

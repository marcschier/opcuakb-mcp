FROM mcr.microsoft.com/dotnet/sdk:10.0.403@sha256:de4fe90a98845d75910b9769662465c84de1a934665c431279d1382b2bddc02b AS build
WORKDIR /src
COPY global.json Directory.Build.props version.json ./
COPY src/OpcUaKb.McpServer/OpcUaKb.McpServer.csproj src/OpcUaKb.McpServer/
COPY src/OpcUaKb.Core/OpcUaKb.Core.csproj src/OpcUaKb.Core/
RUN dotnet restore src/OpcUaKb.McpServer/OpcUaKb.McpServer.csproj
COPY src/OpcUaKb.McpServer/ src/OpcUaKb.McpServer/
COPY src/OpcUaKb.Core/ src/OpcUaKb.Core/
RUN dotnet publish src/OpcUaKb.McpServer/OpcUaKb.McpServer.csproj -c Release -o /app

FROM mcr.microsoft.com/dotnet/aspnet:10.0.14@sha256:de0ee358cdd672f7017a003bed21e9ac9ed48a27c922a59b18175b6e82fa7fee
WORKDIR /app
COPY --from=build /app .
EXPOSE 8080
ENV ASPNETCORE_URLS=http://+:8080
ENTRYPOINT ["dotnet", "OpcUaKb.McpServer.dll"]
